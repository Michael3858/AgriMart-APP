<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".firebase.PaypalDetail"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmallShop"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".ProductPage3"
            android:exported="false" />
        <activity
            android:name=".ProductPage2"
            android:exported="false" />
        <activity
            android:name=".SearchList"
            android:exported="false" />
        <activity
            android:name=".Activity.PaypalActivity"
            android:exported="false" />
        <activity
            android:name=".OtherList"
            android:exported="false" />
        <activity
            android:name=".DairyList"
            android:exported="false" />
        <activity
            android:name=".PoultryList"
            android:exported="false" />
        <activity
            android:name=".FruitList"
            android:exported="false" />
        <activity
            android:name=".VegeList"
            android:exported="false" />
        <activity
            android:name=".ProductPage"
            android:exported="false" />
        <activity
            android:name=".CropList"
            android:exported="false" />
        <activity
            android:name=".Sell"
            android:exported="false" />
        <activity
            android:name=".Activity.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!--
             TODO: Before you run your application, you need a Google Maps API key.

             To get one, follow the directions here:

                https://developers.google.com/maps/documentation/android-sdk/get-api-key

             Once you have your API key (it starts with "AIza"), define a new property in your
             project's local.properties file (e.g. MAPS_API_KEY=Aiza...), and replace the
             "YOUR_API_KEY" string in this file with "${MAPS_API_KEY}".
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${AGRIMART_MAPS_API_KEY}" />

        <activity
            android:name=".MapsActivity"
            android:exported="false"
            android:label="@string/title_activity_maps" />
        <activity
            android:name=".ShoppingCart"
            android:exported="false" />
        <activity
            android:name=".ChooseLanguage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ReviseInfo"
            android:exported="false" />
        <activity
            android:name=".SignUpPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".FrontPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LoginScreen"
            android:exported="false" />

        <service
            android:name=".firebase.MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>