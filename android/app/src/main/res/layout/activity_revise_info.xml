<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffe0"
    tools:context=".ReviseInfo">

    <ImageButton
        android:id="@+id/Back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:scaleType="centerInside"
        android:src="@drawable/back"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/txv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改個人資料"
        android:textSize="50sp"
        android:textStyle="bold"
        android:textColor="#ffbb00"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="50dp"/>

    <TextView
        android:id="@+id/Name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="姓名:"
        android:textSize="20sp"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/txv"
        android:layout_marginTop="50dp"/>

    <EditText
        android:id="@+id/Name2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:selectAllOnFocus="true"
        app:layout_constraintStart_toEndOf="@id/Name"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@id/Name"
        app:layout_constraintBottom_toBottomOf="@id/Name"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"/>

    <TextView
        android:id="@+id/Gender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="性別:"
        android:textSize="20sp"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="@id/Name"
        app:layout_constraintTop_toBottomOf="@id/Name"
        android:layout_marginTop="50dp"/>

    <RadioGroup
        android:id="@+id/RadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toEndOf="@id/Gender"
        app:layout_constraintTop_toTopOf="@id/Gender"
        app:layout_constraintBottom_toBottomOf="@id/Gender">

        <RadioButton
            android:id="@+id/men"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="男"
            android:textSize="20sp"
            android:layout_marginLeft="15dp"/>

        <RadioButton
            android:id="@+id/women"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="女"
            android:textSize="20sp"
            android:layout_marginLeft="15dp" />


    </RadioGroup>

    <TextView
        android:id="@+id/PhoneNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="電話:"
        android:textSize="20sp"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/Gender"
        android:layout_marginTop="50dp"/>

    <EditText
        android:id="@+id/PhoneNum2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:inputType="phone"
        android:selectAllOnFocus="true"
        app:layout_constraintStart_toEndOf="@id/PhoneNum"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@id/PhoneNum"
        app:layout_constraintBottom_toBottomOf="@id/PhoneNum"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"/>

    <TextView
        android:id="@+id/Birthday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="生日:"
        android:textSize="20sp"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/PhoneNum"
        android:layout_marginTop="50dp"/>

    <EditText
        android:id="@+id/Birthday2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:focusable="false"
        app:layout_constraintStart_toEndOf="@id/Birthday"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@id/Birthday"
        app:layout_constraintBottom_toBottomOf="@id/Birthday"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"/>

    <TextView
        android:id="@+id/Address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="地址:"
        android:textSize="20sp"
        android:textColor="#000000"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="40dp"
        app:layout_constraintTop_toBottomOf="@id/Birthday"
        android:layout_marginTop="50dp"/>

    <EditText
        android:id="@+id/Address2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:minLines="1"
        android:maxLines="4"
        android:selectAllOnFocus="true"
        app:layout_constraintStart_toEndOf="@id/Address"
        android:layout_marginStart="5dp"
        app:layout_constraintTop_toTopOf="@id/Address"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="40dp"/>

    <Button
        android:id="@+id/openMapButton"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="Open Map"
        android:textAllCaps="false"
        android:textSize="25sp"
        android:textColor="#ffffff"
        android:background="#7b68ee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="90dp"/>

    <Button
        android:id="@+id/Confirm"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:text="確認修改"
        android:textSize="25sp"
        android:textColor="#ffffff"
        android:background="#7b68ee"
        android:textAllCaps="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="20dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>